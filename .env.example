# AgentTrust KYE — Production Environment Configuration
KYE_DB_PATH=/data/kye_production.db
KYE_TREASURY_WALLET=0x5ab8fBd41e0691876fE3cC3b0dF62A901C2cD044
# Keyless Open x402 Facilitator supporting Base Mainnet USDC (no Coinbase CDP signup needed!)
X402_FACILITATOR_URL=https://facilitator.payai.network
KYE_PRICE_USDC=0.005
KYE_IDEMPOTENCY_TTL_SEC=600
KYE_PROBE_REGION=ap-northeast-1
# Optional: GitHub Personal Access Token (increases GitHub MCP repo discovery rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=
# Optional: Upstream Cloud Oracle URL used by local stdio clients
KYE_ORACLE_URL=https://agenttrust-kye-edge-gateway.a2a-data-matrix.workers.dev
# Cloud Auto-Harvest background scheduler (every 2 hours = 7200s; 0 disables)
KYE_AUTO_HARVEST_INTERVAL_SEC=7200
KYE_AUTO_HARVEST_LIMIT=30
# Required for /v1/admin/* endpoints (generate with: openssl rand -hex 32)
KYE_ADMIN_TOKEN=replace-with-openssl-rand-hex-32
